{
  "name": "bugfix/patchlayout",
  "type": "typo3-cms-extension",
  "description": "Patches for the Backend Layout - Implemented by XClass for the TYPO3 Core",
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.typo3.org"
    }
  ],
  "keywords": [
    "TYPO3 CMS",
    "backend",
    "layout"
  ],
  "support": {
    "issues": "https://github.com/franzholz/patchlayout/issues"
  },
  "homepage": "https://jambage.com",
  "authors": [
    {
      "name": "Franz Holzinger",
      "role": "Developer",
      "homepage": "https://ttproducts.de"
    }
  ],
  "license": [
    "GPL-2.0-or-later"
  ],
  "replace": {
    "typo3-ter/patchlayout": "self.version"
  },
  "require": {
    "typo3/cms-core": "^14"
  },
  "autoload": {
    "psr-4": {
      "Bugfix\\Patchlayout\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "patchlayout",
      "version": "0.4.0",
      "Package": {
        "providesPackages": {}
      }
    }
  }
}

